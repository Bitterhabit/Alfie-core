# Required: private service-to-service credential (32+ characters)
ALFIE_CORE_SERVICE_TOKEN=

# Petrio adapter identity. Optional if Petrio is not connected.
ALFIE_CORE_PETRIO_IDENTITY_SECRET=

# Legacy alias for ALFIE_CORE_PETRIO_IDENTITY_SECRET
ALFIE_CORE_IDENTITY_SECRET=

# Standalone interface backend identity. Required when that client is enabled.
ALFIE_CORE_STANDALONE_IDENTITY_SECRET=

# Optional local or remote model endpoints, kept server-side.
ALFIE_CORE_PROVIDERS_JSON={"mode":"auto","endpoints":[]}

# Used only when the Petrio adapter is enabled and network access is configured.
ALFIE_PETRIO_ADAPTER_URL=http://petrio:3000/v1/alfie-core/tools/run

# Standalone interface session security.
# Set the exact public HTTPS origin used by the reverse proxy.
ALFIE_UI_PUBLIC_ORIGIN=https://alfie.example.local
ALFIE_UI_COOKIE_SECURE=true
# Set true only when the interface is reachable exclusively through a trusted proxy
# that overwrites CF-Connecting-IP. Otherwise the socket peer is used.
ALFIE_UI_TRUST_PROXY_HEADERS=false

# First-run bootstrap account. Use a unique password of at least 16 characters.
# After the first successful startup, remove these two values and restart.
ALFIE_UI_BOOTSTRAP_USERNAME=
ALFIE_UI_BOOTSTRAP_PASSWORD=
